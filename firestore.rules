      }

      match /radarRequests/{requestId} {
        allow get: if isValidId(userId) && isValidId(requestId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(requestId) && isOwner(userId)
          && isValidRadarRequest(incoming(), userId)
          && incoming().status == 'Open'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(requestId) && isOwner(userId)
          && isValidRadarRequest(incoming(), userId)
          && existing().status != 'Resolved'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'quotedPrice', 'quotedSupplierArea', 'fitConfidence', 'reservationExpiresAt', 'disputeStatus', 'updatedAt']);
      }

      match /etimsInvoices/{invoiceId} {
        allow get: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId)
          && isValidEtimsInvoice(incoming(), userId)
          && incoming().status == 'Queued'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(invoiceId) && isOwner(userId)
