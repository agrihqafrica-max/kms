          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(deviceId) && isOwner(userId)
          && isValidDeviceRecord(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'wipePending', 'capabilities', 'updatedAt']);
        allow delete: if false;
      }

      match /approvalRequests/{approvalId} {
        allow get: if isValidId(userId) && isValidId(approvalId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(approvalId) && isOwner(userId)
          && isValidApprovalRequest(incoming(), userId)
          && incoming().status == 'PendingApproval'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(approvalId) && isOwner(userId)
          && isValidApprovalRequest(incoming(), userId)
          && existing().status == 'PendingApproval'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedBy', 'updatedAt']);
        allow delete: if false;
      }

      match /purchaseRequisitions/{reqId} {
        allow get: if isValidId(userId) && isValidId(reqId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(reqId) && isOwner(userId)
          && isValidPurchaseRequisition(incoming(), userId)
          && incoming().status == 'PendingApproval'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(reqId) && isOwner(userId)
          && isValidPurchaseRequisition(incoming(), userId)
          && existing().status in ['PendingApproval', 'Approved']
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if false;
      }

      match /supplierQuotes/{quoteId} {
        allow get: if isValidId(userId) && isValidId(quoteId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(quoteId) && isOwner(userId)
          && isValidSupplierQuote(incoming(), userId)
          && incoming().status == 'Submitted'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(quoteId) && isOwner(userId)
          && isValidSupplierQuote(incoming(), userId)
          && existing().status == 'Submitted'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if false;
      }

      match /inboundContainers/{containerId} {
        allow get: if isValidId(userId) && isValidId(containerId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(containerId) && isOwner(userId)
          && isValidInboundContainer(incoming(), userId)
          && incoming().status == 'Booked'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(containerId) && isOwner(userId)
          && isValidInboundContainer(incoming(), userId)
          && existing().status in ['Booked', 'Cleared', 'In Transit', 'Arrived']
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'etaDate', 'updatedAt']);
        allow delete: if false;
      }

      match /supportTickets/{ticketId} {
        allow get: if isValidId(userId) && isValidId(ticketId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(ticketId) && isOwner(userId)
          && isValidSupportTicket(incoming(), userId)
          && incoming().status == 'Open'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(ticketId) && isOwner(userId)
          && isValidSupportTicket(incoming(), userId)
          && existing().status in ['Open', 'InProgress']
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'updatedAt']);
        allow delete: if false;
      }
    }
  }
}
