      match /transfers/{transferId} {
        allow get: if isValidId(userId) && isValidId(transferId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(transferId) && isOwner(userId)
          && isValidBranchTransfer(incoming(), userId)
          && incoming().status == 'Pending'
          && incoming().createdAt == request.time
