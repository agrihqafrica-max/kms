        allow update: if isValidId(userId) && isValidId(transferId) && isOwner(userId)
          && isValidBranchTransfer(incoming(), userId)
          && existing().status in ['Pending', 'Approved', 'Dispatched']
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
