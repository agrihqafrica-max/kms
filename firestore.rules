        allow create: if isValidId(userId) && isValidId(threadId) && isOwner(userId)
          && isValidChatThread(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(threadId) && isOwner(userId)
          && isValidChatThread(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'rolePreset', 'modelMode', 'updatedAt']);

        match /messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(threadId) && isValidId(messageId) && isOwner(userId);
          allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(threadId) && isValidId(messageId) && isOwner(userId)
            && isValidChatMessage(incoming(), userId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/chatThreads/$(threadId));
          allow update, delete: if false;
        }
      }

      match /journalEntries/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
