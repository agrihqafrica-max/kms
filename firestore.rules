        allow update: if isValidId(userId) && isValidId(supplierId) && isOwner(userId)
          && isValidSupplier(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'area', 'leadTimeDays', 'paymentTerms', 'fillRatePct', 'defectRatePct', 'status', 'updatedAt']);
      }

      match /sales/{saleId} {
        allow get: if isValidId(userId) && isValidId(saleId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(saleId) && isOwner(userId)
          && isValidSalesOrder(incoming(), userId)
          && incoming().createdAt == request.time
          && userExists(userId);
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow get: if isValidId(userId) && isValidId(expenseId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(expenseId) && isOwner(userId)
