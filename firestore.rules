        allow update: if isValidId(userId) && isValidId(countId) && isOwner(userId)
          && isValidStockCount(incoming(), userId)
          && existing().status == 'PendingApproval'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
