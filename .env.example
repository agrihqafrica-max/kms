PORT=3000

# Frontend Supabase & API config
# Leave empty in AI Studio (uses local mock auth + same-origin Express server on port 3000).
# Project ref from Supabase URL/pooler: spuazefszsxrsjihroeg
# Example Supabase URL: https://spuazefszsxrsjihroeg.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Corrected from legacy FastAPI port 8000 -> port 3000 (leave blank in AI Studio preview)
VITE_API_BASE_URL=

# Database connection string
# Note: External TCP connections (e.g. aws-0-eu-west-1.pooler.supabase.com:6543 or :5432)
# are blocked inside the AI Studio container; server.js uses in-memory storage unless
# connected to AI Studio Cloud SQL via Unix Domain Socket.
# For external Node/Postgres deployments, use session pooler (:5432) or disable prepared statements on :6543.
DATABASE_URL=

# Server-side Gemini API key (configured by AI Studio runtime; never expose to frontend)
GEMINI_API_KEY=
# Optional server Firebase reference
FIREBASE_API_KEY=

